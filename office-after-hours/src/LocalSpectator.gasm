; Generated native GRAB Assembly. Connections in level JSON.
SET Player.SelPart 0
LABEL loop
SET Player.SelId Player.LocalId
NOT R7 Player.Valid
IF R7 wait
EQUAL R7 Player.Var5 Round.Pos.Z
IF R7 spectate
SET Player.Var5 Round.Pos.Z
GREATER R7 Round.Pos.Z 1
IF R7 revive
LABEL spectate
EQUAL R7 Player.Var1 1
NOT R7 R7
IF R7 wait
LESS R7 Player.Pos.Y 8
IF R7 relocate
GREATER R7 Player.Pos.Y 11
IF R7 relocate
ABS R0 Player.Pos.X
GREATER R7 R0 2
IF R7 relocate
LESS R7 Player.Pos.Z 0
IF R7 relocate
GREATER R7 Player.Pos.Z 32
IF R7 relocate
GOTO wait
LABEL relocate
SET Player.Tel.Pos.X 0
SET Player.Tel.Pos.Y 8.05
SET Player.Tel.Pos.Z 16
SET Player.Tel.Apply 1
GOTO wait
LABEL revive
SET Player.Var1 0
SET Player.Var3 0
SET Player.Var4 0
MOD R0 Player.Id 10
MOD R1 R0 2
MUL R1 R1 1.4
SUB R1 R1 0.7
MUL R0 R0 0.25
ADD R0 R0 0.5
SET Player.Tel.Pos.X R1
SET Player.Tel.Pos.Y 0.1
SET Player.Tel.Pos.Z R0
SET Player.Tel.Apply 1
LABEL wait
SLEEP 0
GOTO loop
