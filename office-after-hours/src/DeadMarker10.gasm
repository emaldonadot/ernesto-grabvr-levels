; Generated native GRAB Assembly. Connections in level JSON.
SET Player.SelPart 0
LABEL loop
SET Dead10.Pos.Y -100
SET Player.SelIndex 10
NOT R7 Player.Valid
IF R7 wait
EQUAL R7 Player.Var1 1
NOT R7 R7
IF R7 wait
SET Dead10.Pos.X Player.Pos.X
ADD Dead10.Pos.Y Player.Pos.Y 0.65
SET Dead10.Pos.Z Player.Pos.Z
LABEL wait
SLEEP 0
GOTO loop
