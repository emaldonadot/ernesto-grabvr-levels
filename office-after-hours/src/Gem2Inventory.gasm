; Generated native GRAB Assembly. Connections in level JSON.
SET Player.SelPart 0
LABEL loop
SET Gem2.Pos.Y -100
IF LootB.Pos.Y owned
NOT R7 LootB.Pos.X
IF R7 wait
EQUAL R7 LootB.Pos.X 1
NOT R7 R7
IF R7 skip1
SET Gem2.Pos.X Drawer1.Pos.X
ADD Gem2.Pos.Y Drawer1.Pos.Y 0.17
SET Gem2.Pos.Z Drawer1.Pos.Z
GOTO wait
LABEL skip1
EQUAL R7 LootB.Pos.X 2
NOT R7 R7
IF R7 skip2
SET Gem2.Pos.X Drawer2.Pos.X
ADD Gem2.Pos.Y Drawer2.Pos.Y 0.17
SET Gem2.Pos.Z Drawer2.Pos.Z
GOTO wait
LABEL skip2
EQUAL R7 LootB.Pos.X 3
NOT R7 R7
IF R7 skip3
SET Gem2.Pos.X Drawer3.Pos.X
ADD Gem2.Pos.Y Drawer3.Pos.Y 0.17
SET Gem2.Pos.Z Drawer3.Pos.Z
GOTO wait
LABEL skip3
EQUAL R7 LootB.Pos.X 4
NOT R7 R7
IF R7 skip4
SET Gem2.Pos.X Drawer4.Pos.X
ADD Gem2.Pos.Y Drawer4.Pos.Y 0.17
SET Gem2.Pos.Z Drawer4.Pos.Z
GOTO wait
LABEL skip4
EQUAL R7 LootB.Pos.X 5
NOT R7 R7
IF R7 skip5
SET Gem2.Pos.X Drawer5.Pos.X
ADD Gem2.Pos.Y Drawer5.Pos.Y 0.17
SET Gem2.Pos.Z Drawer5.Pos.Z
GOTO wait
LABEL skip5
EQUAL R7 LootB.Pos.X 6
NOT R7 R7
IF R7 skip6
SET Gem2.Pos.X Drawer6.Pos.X
ADD Gem2.Pos.Y Drawer6.Pos.Y 0.17
SET Gem2.Pos.Z Drawer6.Pos.Z
GOTO wait
LABEL skip6
EQUAL R7 LootB.Pos.X 7
NOT R7 R7
IF R7 skip7
SET Gem2.Pos.X Drawer7.Pos.X
ADD Gem2.Pos.Y Drawer7.Pos.Y 0.17
SET Gem2.Pos.Z Drawer7.Pos.Z
GOTO wait
LABEL skip7
EQUAL R7 LootB.Pos.X 8
NOT R7 R7
IF R7 skip8
SET Gem2.Pos.X Drawer8.Pos.X
ADD Gem2.Pos.Y Drawer8.Pos.Y 0.17
SET Gem2.Pos.Z Drawer8.Pos.Z
GOTO wait
LABEL skip8
EQUAL R7 LootB.Pos.X 9
NOT R7 R7
IF R7 skip9
SET Gem2.Pos.X Drawer9.Pos.X
ADD Gem2.Pos.Y Drawer9.Pos.Y 0.17
SET Gem2.Pos.Z Drawer9.Pos.Z
GOTO wait
LABEL skip9
EQUAL R7 LootB.Pos.X 10
NOT R7 R7
IF R7 skip10
SET Gem2.Pos.X Drawer10.Pos.X
ADD Gem2.Pos.Y Drawer10.Pos.Y 0.17
SET Gem2.Pos.Z Drawer10.Pos.Z
GOTO wait
LABEL skip10
GOTO wait
LABEL owned
SUB R0 LootB.Pos.Y 1
SET Player.SelId R0
NOT R7 Player.Valid
IF R7 lost
IF Player.Var1 lost
SET Gem2.Pos.X Player.Pos.X
ADD Gem2.Pos.Y Player.Pos.Y 0.5
SET Gem2.Pos.Z Player.Pos.Z
GOTO wait
LABEL lost
SET LootB.Pos.Y 0
RAND LootB.Pos.X 10
ADD LootB.Pos.X LootB.Pos.X 1
LABEL wait
SLEEP 0
GOTO loop
