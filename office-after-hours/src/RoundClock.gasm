; Generated native GRAB Assembly. Connections in level JSON.
SET Player.SelPart 0
SET Round.Pos.Z 1
SET Round.Pos.X 0
SET Round.Pos.Y 0
GOTO initialize
LABEL loop
SET ResetAnimations.Trg.Force 0
SET Restart1.Pos.Y -100
SET Restart2.Pos.Y -100
SET Restart3.Pos.Y -100
SET Restart4.Pos.Y -100
SET Restart5.Pos.Y -100
IF Round.Pos.X countdown
SET R0 0
SET R1 0
SET R2 0
LABEL scan
SET Player.SelIndex R0
NOT R7 Player.Valid
IF R7 next
ADD R1 R1 1
EQUAL R7 Player.Var1 1
ADD R2 R2 R7
LABEL next
ADD R0 R0 1
LESS R7 R0 Player.Count
IF R7 scan
NOT R7 R1
IF R7 advance
EQUAL R7 R1 R2
NOT R7 R7
IF R7 advance
SET Round.Pos.X 1
SET Round.Pos.Y 5
SET Clock.Pos.X 0
SET Monster.Pos.Y -100
SET Target.Pos.X 0
GOTO display
LABEL countdown
SUB Round.Pos.Y Round.Pos.Y DeltaTime
GREATER R7 Round.Pos.Y 0.00001
IF R7 display
ADD Round.Pos.Z Round.Pos.Z 1
SET Round.Pos.X 0
SET Round.Pos.Y 0
SET ResetAnimations.Trg.Force 1
SET R0 0
LABEL revive
SET Player.SelIndex R0
NOT R7 Player.Valid
IF R7 revived
SET Player.Var1 0
SET Player.Var3 0
SET Player.Var4 0
LABEL revived
ADD R0 R0 1
LESS R7 R0 Player.Count
IF R7 revive
SET Spots1.Pos.X 0
SET Spots1.Pos.Y 0
SET Spots1.Pos.Z 0
SET Edge1.Pos.X 0
SET Edge1.Pos.Y 0
SET Edge1.Pos.Z 0
SET EdgeB1.Pos.X 0
SET EdgeB1.Pos.Y 0
SET EdgeB1.Pos.Z 0
