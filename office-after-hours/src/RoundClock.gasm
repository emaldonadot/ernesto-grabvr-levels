SET Edge5.Pos.X 0
SET Edge5.Pos.Y 0
SET Edge5.Pos.Z 0
SET EdgeB5.Pos.X 0
SET EdgeB5.Pos.Y 0
SET EdgeB5.Pos.Z 0
