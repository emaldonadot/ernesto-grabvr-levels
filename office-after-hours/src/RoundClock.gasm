SET Spots6.Pos.Y 0
SET Spots6.Pos.Z 0
SET Edge6.Pos.X 0
SET Edge6.Pos.Y 0
SET Edge6.Pos.Z 0
SET EdgeB6.Pos.X 0
SET EdgeB6.Pos.Y 0
SET EdgeB6.Pos.Z 0
SET Spots7.Pos.X 0
SET Spots7.Pos.Y 0
SET Spots7.Pos.Z 0
SET Edge7.Pos.X 0
SET Edge7.Pos.Y 0
SET Edge7.Pos.Z 0
SET EdgeB7.Pos.X 0
SET EdgeB7.Pos.Y 0
SET EdgeB7.Pos.Z 0
SET Spots8.Pos.X 0
SET Spots8.Pos.Y 0
SET Spots8.Pos.Z 0
SET Edge8.Pos.X 0
SET Edge8.Pos.Y 0
SET Edge8.Pos.Z 0
SET EdgeB8.Pos.X 0
SET EdgeB8.Pos.Y 0
SET EdgeB8.Pos.Z 0
SET Spots9.Pos.X 0
