SET Spots9.Pos.Z 0
SET Edge9.Pos.X 0
SET Edge9.Pos.Y 0
SET Edge9.Pos.Z 0
SET EdgeB9.Pos.X 0
SET EdgeB9.Pos.Y 0
SET EdgeB9.Pos.Z 0
SET Spots10.Pos.X 0
SET Spots10.Pos.Y 0
SET Spots10.Pos.Z 0
SET Edge10.Pos.X 0
SET Edge10.Pos.Y 0
SET Edge10.Pos.Z 0
SET EdgeB10.Pos.X 0
SET EdgeB10.Pos.Y 0
SET EdgeB10.Pos.Z 0
LABEL initialize
SET Clock.Pos.X 0
SET Clock.Pos.Y 0
SET Clock.Pos.Z 0
SET KeyState.Pos.X 0
SET KeyState.Pos.Y 0
SET KeyState.Pos.Z 0
SET ExitState.Pos.X 0
SET Monster.Pos.Y -100
SET Target.Pos.X 0
GOTO relocate
LABEL advance
ADD Clock.Pos.Z Clock.Pos.Z DeltaTime
LESS R7 Clock.Pos.Z 60
IF R7 wait
SUB Clock.Pos.Z Clock.Pos.Z 60
IF Clock.Pos.X end_attack
SET Clock.Pos.X 1
GOTO wait
LABEL end_attack
SET Clock.Pos.X 0
ADD Clock.Pos.Y Clock.Pos.Y 1
LESS R7 Clock.Pos.Y 5
IF R7 relocate
IF KeyState.Pos.Z relocate
RAND KeyState.Pos.X 10
ADD KeyState.Pos.X KeyState.Pos.X 1
SET KeyState.Pos.Z KeyState.Pos.X
LABEL relocate
SET R4 LootA.Pos.X
SET R5 LootB.Pos.X
SET R6 LootC.Pos.X
LABEL rollA
RAND LootA.Pos.X 10
ADD LootA.Pos.X LootA.Pos.X 1
EQUAL R7 LootA.Pos.X R5
IF R7 rollA
EQUAL R7 LootA.Pos.X R6
IF R7 rollA
EQUAL R7 LootA.Pos.X R4
IF R7 rollA
LABEL rollB
RAND LootB.Pos.X 10
ADD LootB.Pos.X LootB.Pos.X 1
EQUAL R7 LootB.Pos.X R4
IF R7 rollB
EQUAL R7 LootB.Pos.X R6
IF R7 rollB
EQUAL R7 LootA.Pos.X LootB.Pos.X
IF R7 rollB
EQUAL R7 LootB.Pos.X R5
IF R7 rollB
LABEL rollC
RAND LootC.Pos.X 10
ADD LootC.Pos.X LootC.Pos.X 1
EQUAL R7 LootC.Pos.X R4
IF R7 rollC
EQUAL R7 LootC.Pos.X R5
IF R7 rollC
EQUAL R7 LootA.Pos.X LootC.Pos.X
IF R7 rollC
EQUAL R7 LootB.Pos.X LootC.Pos.X
IF R7 rollC
EQUAL R7 LootC.Pos.X R6
IF R7 rollC
SET LootA.Pos.Y 0
ADD LootA.Pos.Z LootA.Pos.Z 1
SET LootB.Pos.Y 0
ADD LootB.Pos.Z LootB.Pos.Z 1
SET LootC.Pos.Y 0
ADD LootC.Pos.Z LootC.Pos.Z 1
GOTO wait
LABEL display
ADD R0 Round.Pos.Y 0.99999
FLOOR R0 R0
EQUAL R7 R0 1
NOT R7 R7
IF R7 display1
SET Restart1.Pos.Y 9.8
LABEL display1
EQUAL R7 R0 2
NOT R7 R7
IF R7 display2
SET Restart2.Pos.Y 9.8
LABEL display2
EQUAL R7 R0 3
NOT R7 R7
IF R7 display3
SET Restart3.Pos.Y 9.8
LABEL display3
EQUAL R7 R0 4
NOT R7 R7
IF R7 display4
SET Restart4.Pos.Y 9.8
LABEL display4
EQUAL R7 R0 5
NOT R7 R7
IF R7 display5
SET Restart5.Pos.Y 9.8
LABEL display5
LABEL wait
SLEEP 0
GOTO loop
