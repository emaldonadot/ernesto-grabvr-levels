; Generated native GRAB Assembly. Connections in level JSON.
SET Player.SelPart 0
LABEL loop
IF Clock.Pos.X hunting
SET Monster.Pos.Y -100
SET Target.Pos.X 0
GOTO wait
LABEL hunting
GREATER R7 Monster.Pos.Y -50
IF R7 scan
SET Monster.Pos.Y 0
SET Monster.Pos.X -17.7
SET Monster.Pos.Z 0
LABEL scan
SET Player.SelPart 0
SET R0 0
SET R5 100000
SET Target.Pos.X 0
LABEL players
SET Player.SelIndex R0
NOT R7 Player.Valid
IF R7 next
IF Player.Var1 next
IF Player.Var3 next
ADD R6 Player.Id 1
EQUAL R7 LootA.Pos.Y R6
IF R7 next
EQUAL R7 LootB.Pos.Y R6
IF R7 next
EQUAL R7 LootC.Pos.Y R6
IF R7 next
SUB R1 Player.Pos.X Monster.Pos.X
SUB R2 Player.Pos.Z Monster.Pos.Z
MUL R1 R1 R1
MUL R2 R2 R2
ADD R1 R1 R2
LESS R7 R1 R5
NOT R7 R7
IF R7 next
SET R5 R1
SET Target.Pos.X R6
SET Target.Pos.Y Player.Pos.X
SET Target.Pos.Z Player.Pos.Z
LABEL next
ADD R0 R0 1
LESS R7 R0 Player.Count
IF R7 players
NOT R7 Target.Pos.X
IF R7 wait
SET Waypoint.Pos.X Target.Pos.Y
SET Waypoint.Pos.Z Target.Pos.Z
LESS R7 Monster.Pos.Z -8.85
IF R7 lower1
GREATER R7 Monster.Pos.Z 8.85
IF R7 upper2
SET R0 0
GOTO aisle3
LABEL lower1
SET R0 -17.7
GOTO aisle3
LABEL upper2
SET R0 17.7
LABEL aisle3
LESS R7 Target.Pos.Z -8.85
IF R7 lower4
GREATER R7 Target.Pos.Z 8.85
IF R7 upper5
SET R1 0
GOTO aisle6
LABEL lower4
SET R1 -17.7
GOTO aisle6
LABEL upper5
SET R1 17.7
LABEL aisle6
EQUAL R7 R0 R1
IF R7 sameaisle
GREATER R7 Monster.Pos.X 0
IF R7 rightside
SET R2 -17.7
GOTO sidechosen
LABEL rightside
SET R2 17.7
LABEL sidechosen
SET Waypoint.Pos.X R2
SET Waypoint.Pos.Z R0
SUB R3 Monster.Pos.X R2
ABS R3 R3
LESS R7 R3 0.25
IF R7 vertical
SUB R3 Monster.Pos.Z R0
ABS R3 R3
GREATER R7 R3 0.25
IF R7 aisleentry
GOTO route_done
LABEL vertical
SET Waypoint.Pos.Z R1
GOTO route_done
LABEL aisleentry
SET Waypoint.Pos.X Monster.Pos.X
GOTO route_done
LABEL sameaisle
SUB R3 Target.Pos.Y Monster.Pos.X
ABS R3 R3
LESS R7 R3 0.3
IF R7 route_done
SET Waypoint.Pos.Z R0
SUB R3 Monster.Pos.Z R0
ABS R3 R3
LESS R7 R3 0.25
IF R7 route_done
SET Waypoint.Pos.X Monster.Pos.X
LABEL route_done
SUB R1 Waypoint.Pos.X Monster.Pos.X
SUB R2 Waypoint.Pos.Z Monster.Pos.Z
MUL R3 R1 R1
MUL R4 R2 R2
ADD R3 R3 R4
SQRT R3 R3
LESS R7 R3 0.02
IF R7 catch
ATAN2 Monster.Rot.Y R1 R2
ADD Monster.Rot.Y Monster.Rot.Y 180
MUL R4 DeltaTime 3.7
GREATER R7 R4 R3
NOT R7 R7
IF R7 step
SET R4 R3
LABEL step
DIV R4 R4 R3
MUL R1 R1 R4
MUL R2 R2 R4
ADD Monster.Pos.X Monster.Pos.X R1
ADD Monster.Pos.Z Monster.Pos.Z R2
LABEL catch
SUB R0 Target.Pos.X 1
SET Player.SelId R0
NOT R7 Player.Valid
IF R7 wait
IF Player.Var1 wait
IF Player.Var3 wait
NOT R7 Clock.Pos.X
IF R7 wait
ADD R6 Player.Id 1
EQUAL R7 LootA.Pos.Y R6
IF R7 wait
EQUAL R7 LootB.Pos.Y R6
IF R7 wait
EQUAL R7 LootC.Pos.Y R6
IF R7 wait
SUB R1 Player.Pos.X Monster.Pos.X
SUB R2 Player.Pos.Z Monster.Pos.Z
MUL R1 R1 R1
MUL R2 R2 R2
ADD R1 R1 R2
GREATER R7 R1 0.65
IF R7 wait
GREATER R7 Player.Pos.Y 4.5
IF R7 wait
SET Player.Var1 1
SET Player.Var2 0
SET Player.Var3 0
SET Player.Var4 0
LABEL wait
SLEEP 0
GOTO loop
